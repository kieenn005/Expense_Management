    <style name="Theme.Spending_Management" parent="Base.Theme.Spending_Management" />
    <style name="App.CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/surfaceMuted</item>
    </style>
</resources>
