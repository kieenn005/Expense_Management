<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Spending_Management" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surfaceCard</item>
        <item name="android:navigationBarColor">@color/surfaceCard</item>
        <item name="colorPrimary">@color/primaryBlue</item>
        <item name="colorSecondary">@color/orange</item>
        <item name="colorSurface">@color/surfaceCard</item>
        <item name="android:windowBackground">@color/screenBackground</item>
